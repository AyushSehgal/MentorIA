# Copy to .env (never commit .env). MentorIA starts empty; add data on the Add data page or configure connectors below.
DEMO_MODE=true
MENTORIA_TIMEZONE=America/New_York
MENTORIA_DB_PATH=backend/data/mentoria.db
# Who the demo student is. Emails FROM this address are treated as written by the student.
MENTORIA_STUDENT_NAME=Ayush
MENTORIA_STUDENT_EMAIL=ayush.student@example.edu

# Optional LLM wording layer. Answers are always built from stored evidence first; an LLM may only reword them.
# Initial mode: local (default) | off | cloud. The student can change it later on the Sources page ("Privacy & AI").
# If no local model server is running, answers fall back to the grounded draft automatically.
LLM_MODE=local
LLM_TIMEOUT_SECONDS=90
# Local (on-device): any OpenAI-compatible server on localhost — Ollama (default), LM Studio (:1234/v1), llama.cpp.
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_MODEL=qwen2.5
# Cloud: openrouter (default) or anthropic
LLM_CLOUD_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Pick any model id from https://openrouter.ai/models, e.g. a Claude, Llama or Qwen model
OPENROUTER_MODEL=
# false = ask OpenRouter to route only to providers that don't store/train on prompts
OPENROUTER_ALLOW_DATA_COLLECTION=false
# Used only when LLM_CLOUD_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Canvas (personal access token from Canvas > Account > Settings > New Access Token)
CANVAS_BASE_URL=
CANVAS_API_TOKEN=

# Google (Calendar + Gmail). Run scripts/google_auth.py once to create GOOGLE_TOKEN_FILE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_FILE=backend/data/google_token.json
GOOGLE_CALENDAR_WRITE_ENABLED=false

# Piazza has no official public API. Live mode uses the unofficial `piazza-api` package if installed.
PIAZZA_ENABLED=false
PIAZZA_EMAIL=
PIAZZA_PASSWORD=
PIAZZA_NETWORK_IDS=
